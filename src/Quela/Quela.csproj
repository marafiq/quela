<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Package metadata -->
    <PackageId>Quela</PackageId>
    <Version>0.1.0</Version>
    <Authors>Quela Contributors</Authors>
    <Description>Type-safe SQL DSL for .NET - Write SQL with compile-time safety</Description>
    <PackageTags>sql;dsl;query-builder;dapper;type-safe</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/quela/quela</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dapper for execution -->
    <PackageReference Include="Dapper" Version="2.1.*" />
  </ItemGroup>

</Project>
