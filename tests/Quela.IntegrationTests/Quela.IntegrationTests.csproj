<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <!-- Conditional SQL Server support - set to true when SQL Server client is available -->
    <UseSqlServerClient Condition="'$(UseSqlServerClient)' == ''">false</UseSqlServerClient>
    <DefineConstants Condition="'$(UseSqlServerClient)' == 'true'">$(DefineConstants);SQL_SERVER_CLIENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseSqlServerClient)' == 'true'">
    <!-- SQL Server connectivity -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.*" />
    <!-- SQL Server T-SQL parser for syntax validation -->
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="161.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Quela\Quela.csproj" />
  </ItemGroup>

</Project>
