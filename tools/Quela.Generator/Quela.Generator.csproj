<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Quela.Generator</RootNamespace>
    <AssemblyName>quela-gen</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quela-gen</ToolCommandName>
    <PackageId>Quela.Generator</PackageId>
    <Version>1.0.0</Version>
    <Description>CLI tool to generate type-safe C# schema classes from SQL Server database</Description>
    <!-- Conditional SQL Server support - set to false for offline builds -->
    <UseSqlServerClient Condition="'$(UseSqlServerClient)' == ''">true</UseSqlServerClient>
    <DefineConstants Condition="'$(UseSqlServerClient)' == 'true'">$(DefineConstants);SQL_SERVER_CLIENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseSqlServerClient)' == 'true'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.0" />
  </ItemGroup>

</Project>
